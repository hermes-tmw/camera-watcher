FROM python:3-bookworm

RUN apt-get update && apt-get -y install sqlite3 redis ffmpeg

WORKDIR /app
COPY requirements-classifier.txt ./
RUN python3 -m pip install -r requirements-classifier.txt

RUN mkdir -p /app/camera-watcher
WORKDIR /app/camera-watcher

COPY *.py ./
COPY watcher watcher/

ARG GIT_VERSION=unknown
RUN echo $GIT_VERSION > VERSION

# Build-time config: prefer the operator's real etc/watcher.cfg; when absent
# (it is git-ignored) bake the committed example instead. Runtime reads the
# ./etc bind-mount, not this baked copy.
COPY ./etc/watcher.cfg* /usr/local/etc/
RUN [ -f /usr/local/etc/watcher.cfg ] || { cp /usr/local/etc/watcher.cfg.example /usr/local/etc/watcher.cfg && echo "watcher.cfg: example in use (operators: create etc/watcher.cfg for real settings)"; }
